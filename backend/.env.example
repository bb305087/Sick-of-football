# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DATABASE_URL=postgresql+asyncpg://sof_app:change-me@db:5432/sof
SICK_OF_FOOTBALL_JWT_SECRET=
# JSON map of key id to base64-encoded 32-byte AES key, for example:
# {"1":"<base64-encoded-32-byte-key>"}
SICK_OF_FOOTBALL_DATA_ENCRYPTION_KEYS=
ACTIVE_ENCRYPTION_KEY_ID=1
ENV=prod
# Set to true only when the certificate and key are mounted in backend/certs
# (or provide HTTPS_CERTFILE and HTTPS_KEYFILE paths inside the container).
HTTPS_ENABLED=true
HTTPS_CERTFILE=/certs/fullchain.pem
HTTPS_KEYFILE=/certs/privkey.pem
# Development only: generate a local self-signed certificate when missing.
HTTPS_AUTO_GENERATE_DEV_CERT=true
